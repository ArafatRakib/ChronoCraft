      durationMs: typeof p.durationMs === 'number' && !isNaN(p.durationMs) ? Math.max(1000, p.durationMs) : 60000,
    }));
  } catch {
    return [];
  }
}

export function saveCustomPresets(items: TimerPreset[]) {
