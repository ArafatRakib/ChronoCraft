              <span>{stopwatch.isRunning ? 'Running' : elapsedMs > 0 ? 'Paused' : 'Ready'}</span>
              {hasTarget && (
                <span className={`font-semibold ${isGoalReached ? 'text-emerald-500' : 'text-indigo-500'}`}>
